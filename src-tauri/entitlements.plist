<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Windle is a maintenance tool: it must read and write outside its own
	     container, so the App Sandbox stays off. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Required for JIT in the WebKit web view under the hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Reading arbitrary user-selected locations for disk analysis. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<!-- Shelling out to system utilities (purge, dscacheutil, hdiutil, mdutil). -->
	<key>com.apple.security.inherit</key>
	<false/>

	<!-- Update checks and telemetry-free network use. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
